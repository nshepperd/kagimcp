# Secrets for the kagimcp systemd service.
# Install as /etc/kagimcp/env, owned root:root, chmod 600.
#
# systemd's EnvironmentFile does NO shell expansion: the $ signs in the
# password hash are safe to paste verbatim, unquoted.

KAGIMCP_USERNAME=emily

# Generate with: kagimcp --hash-password
KAGIMCP_PASSWORD_HASH=pbkdf2_sha256$600000$replace$me

# Public HTTPS origin nginx serves this under.
KAGIMCP_BASE_URL=https://kagi.eepylomf.net

#FASTMCP_LOG_LEVEL=INFO
