# Kagi MCP server in OAuth mode, hardened.
#
# Expects:
#   /opt/kagimcp          - this repo, with a synced .venv (uv sync)
#   /etc/kagimcp/env      - secrets, root:root 0600 (see env.example)
#   /var/lib/kagimcp      - created automatically via StateDirectory
#
# Install:
#   cp deploy/kagimcp.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now kagimcp

[Unit]
Description=Kagi MCP server (OAuth mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Ephemeral UID for the lifetime of the service: nothing on disk belongs to it
# except the state directory, which systemd chowns on the fly.
DynamicUser=yes
StateDirectory=kagimcp
EnvironmentFile=/etc/kagimcp/env
WorkingDirectory=/opt/kagimcp
# Bind loopback only - nginx is the public face and does TLS.
ExecStart=/opt/kagimcp/.venv/bin/kagimcp --http --host 127.0.0.1 --port 8000 \
    --auth oauth --db /var/lib/kagimcp/kagimcp.db
Restart=on-failure
RestartSec=2

# --- sandbox -------------------------------------------------------------
NoNewPrivileges=yes
# Whole filesystem read-only except /var/lib/kagimcp (via StateDirectory).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX stays: glibc NSS may resolve DNS through systemd-resolved's socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Pure CPython 3.12 + wheels, no JIT/ctypes: W^X is safe here. If a future
# dependency segfaults at import, this is the first knob to relax.
MemoryDenyWriteExecute=yes
UMask=0077
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
